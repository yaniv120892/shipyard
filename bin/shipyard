#!/usr/bin/env node
import { execFile } from 'node:child_process';
import { loadConfig } from '../lib/config.js';
import { createEngine } from '../lib/engine.js';
import { createServer, startServer } from '../server.js';
import { createToken } from '../lib/security.js';
import { buildDemoEngine } from '../scripts/demo.js';

const args = process.argv.slice(2);
const demo = args.includes('--demo');
const portFlag = args.includes('--port') ? Number(args[args.indexOf('--port') + 1]) : null;
const { config, created, missingRoots, configError } = loadConfig({});
const port = portFlag ?? config.port;
if (configError) {
  console.log(`shipyard: config file could not be parsed (${configError}) — using defaults`);
}

async function existingInstance(port) {
  try {
    const response = await fetch(`http://127.0.0.1:${port}/api/health`, {
      signal: AbortSignal.timeout(1000),
    });
    const body = await response.json();
    return body.name === 'shipyard';
  } catch {
    return false;
  }
}

function openBrowser(url) {
  const cmd = process.platform === 'darwin' ? 'open' : 'xdg-open';
  execFile(cmd, [url], () => {});
}

if (await existingInstance(port)) {
  console.log(`shipyard already running at http://127.0.0.1:${port} — opening it`);
  openBrowser(`http://127.0.0.1:${port}`);
  process.exit(0);
}

const token = createToken();
const engine = demo
  ? buildDemoEngine()
  : createEngine({ config, setup: { created, missingRoots, roots: config.roots, configError } });
const server = createServer({ token, version: '0.1.0', engine, config });
let bound;
try {
  bound = await startServer(server, port);
} catch {
  bound = await startServer(server, 0); // port taken by something else
  console.log(`port ${port} is taken by another app — using ${bound}`);
}
engine.start();
const url = `http://127.0.0.1:${bound}`;
console.log(`shipyard: ${url}`);
if (demo) {
  console.log('demo mode — showing fixture data, nothing on disk is scanned');
}
if (created && !demo) {
  console.log('first run — confirm scan roots in the setup panel');
}
openBrowser(url);
